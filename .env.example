# Copy to .env and change production secrets before deployment.
GATELINK_VERSION=local

POSTGRES_DB=gatelink
POSTGRES_USER=gatelink
POSTGRES_PASSWORD=change-me-before-production

OIDC_ENABLED=false
OIDC_AUTH_SERVER_URL=https://id.example.invalid/realms/gatelink
OIDC_CLIENT_ID=gatelink-server

WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:admin@example.com

OTEL_EXPORT_ENABLED=false

# Add the host DNS name/IP used by clients before the first start when
# it differs from localhost. Certificates persist in named volumes.
TLS_DAYS=825
UI_TLS_COMMON_NAME=quarkus-gatelink-webpush-ui
UI_TLS_SAN=DNS:quarkus-gatelink-webpush-ui,DNS:localhost,IP:127.0.0.1
SERVER_TLS_COMMON_NAME=quarkus-gatelink-webpush-server
SERVER_TLS_SAN=DNS:quarkus-gatelink-webpush-server,DNS:localhost,IP:127.0.0.1
