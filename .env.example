# Copy to .env and change production secrets before deployment.

GATELINK_VERSION=local
FRONTEND_PORT=8081

POSTGRES_DB=gatelink
POSTGRES_USER=gatelink
POSTGRES_PASSWORD=change-me-before-production

# The requested Compose stack contains no identity provider. Leave false for a
# self-contained local boot. Production admin endpoints require true plus a
# reachable external OIDC issuer and a token carrying role gatelink-admin.
OIDC_ENABLED=false
OIDC_AUTH_SERVER_URL=https://id.example.invalid/realms/gatelink
OIDC_CLIENT_ID=gatelink-server

# Leave both VAPID keys empty only for temporary development. GateLink then
# generates an ephemeral pair. Production must use a stable P-256 VAPID pair.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:admin@example.com

# Enable only when an OTLP collector endpoint is configured for the deployment.
OTEL_EXPORT_ENABLED=false
